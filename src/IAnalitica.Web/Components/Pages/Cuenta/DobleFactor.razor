@page "/cuenta/doble-factor"
@attribute [Authorize]
@using IAnalitica.Application.Abstracciones
@using IAnalitica.Infrastructure.Identity
@using IAnalitica.Web.Components.Pages.Comunes
@using Microsoft.AspNetCore.Identity
@inject SignInManager<UsuarioAplicacion> Sesion
@inject UserManager<UsuarioAplicacion> Usuarios
@inject IAuditoriaSeguridad Auditoria

<PageTitle>Doble factor · IAnalitica</PageTitle>
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">Verificación en dos pasos</h1>
        @if (codigosRecuperacion is not null)
        {
            <div class="alert alert-success" role="alert">El doble factor quedó activo.</div>
            <p><strong>Guarde estos códigos de recuperación en un lugar seguro.</strong> Cada uno sirve una sola vez y no se volverán a mostrar.</p>
            <pre id="codigos" class="border p-3 bg-light">@string.Join("\n", codigosRecuperacion)</pre>
            <button type="button" class="btn btn-outline-secondary btn-sm" data-copiar="codigos">Copiar</button>
            <p class="mt-3"><a class="btn btn-primary" href="/">Continuar</a></p>
        }
        else if (yaActivo)
        {
            <div class="alert alert-success" role="alert">El doble factor está activo en su cuenta.</div>
            <p><a href="/">Volver al inicio</a></p>
        }
        else
        {
            <p>Para proteger los datos de su institución, configure una aplicación autenticadora (por ejemplo Microsoft Authenticator o Google Authenticator).</p>
            <ol>
                <li>En la aplicación elija «agregar cuenta» y escriba esta clave: <code id="clave-2fa" class="user-select-all">@claveFormateada</code>
                    <button type="button" class="btn btn-outline-secondary btn-sm ms-2" data-copiar="clave-2fa">Copiar</button></li>
                <li>Escriba abajo el código de 6 dígitos que muestra la aplicación.</li>
            </ol>
            <p class="text-muted small">Enlace para aplicaciones compatibles: <span class="user-select-all">@uri</span></p>
            <Mensajes Errores="errores" />
            <EditForm Model="Entrada" FormName="activar-2fa" OnValidSubmit="ActivarAsync" method="post">
                <DataAnnotationsValidator />
                <div class="mb-3">
                    <label class="form-label" for="codigo">Código de verificación</label>
                    <InputText id="codigo" class="form-control" @bind-Value="Entrada.Codigo" autocomplete="one-time-code" inputmode="numeric" />
                    <ValidationMessage For="() => Entrada.Codigo" />
                </div>
                <button class="btn btn-primary" type="submit">Activar</button>
            </EditForm>
        }
    </div>
</div>

@code {
    private List<string>? errores;
    private string claveFormateada = "";
    private string uri = "";
    private bool yaActivo;
    private IReadOnlyList<string>? codigosRecuperacion;

    [CascadingParameter] private HttpContext? Http { get; set; }
    [SupplyParameterFromForm(Name = "Entrada")] private EntradaCodigo? EntradaPublicada { get; set; }
    private EntradaCodigo Entrada => EntradaPublicada ??= new();

    protected override async Task OnInitializedAsync()
    {
        var usuario = await Usuarios.GetUserAsync(Http!.User);
        if (usuario is null) return;
        if (usuario.TwoFactorEnabled) { yaActivo = true; return; }
        await PrepararClaveAsync(usuario);
    }

    private async Task PrepararClaveAsync(UsuarioAplicacion usuario)
    {
        var clave = await Usuarios.GetAuthenticatorKeyAsync(usuario);
        if (string.IsNullOrEmpty(clave))
        {
            await Usuarios.ResetAuthenticatorKeyAsync(usuario);   // renueva el sello de seguridad: sin reemitir el cookie, la sesión se caería en la siguiente validación
            clave = await Usuarios.GetAuthenticatorKeyAsync(usuario);
            await Sesion.RefreshSignInAsync(usuario);
        }
        claveFormateada = string.Join(' ', Enumerable.Range(0, (clave!.Length + 3) / 4).Select(i => clave.Substring(i * 4, Math.Min(4, clave.Length - i * 4))));
        uri = $"otpauth://totp/IAnalitica:{Uri.EscapeDataString(usuario.UserName!)}?secret={clave}&issuer=IAnalitica&digits=6";
    }

    private async Task ActivarAsync()
    {
        var usuario = await Usuarios.GetUserAsync(Http!.User);
        if (usuario is null) return;
        var codigo = Entrada.Codigo.Replace(" ", "").Replace("-", "");
        var valido = await Usuarios.VerifyTwoFactorTokenAsync(usuario, Usuarios.Options.Tokens.AuthenticatorTokenProvider, codigo);
        if (!valido)
        {
            errores = ["El código no es correcto. Revise la hora de su teléfono e intente de nuevo."];
            await PrepararClaveAsync(usuario);
            return;
        }

        await Usuarios.SetTwoFactorEnabledAsync(usuario, true);
        codigosRecuperacion = (await Usuarios.GenerateNewTwoFactorRecoveryCodesAsync(usuario, 10))!.ToList();
        await Sesion.RefreshSignInAsync(usuario);
        await Auditoria.RegistrarAsync("MFA_ACTIVADO", usuario.EmpresaId, usuario.Id, usuario.UserName, null, Http.Connection.RemoteIpAddress?.ToString(), default);
    }

    private sealed class EntradaCodigo
    {
        [Required(ErrorMessage = "Escriba el código.")] public string Codigo { get; set; } = "";
    }
}

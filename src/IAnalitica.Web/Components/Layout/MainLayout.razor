@inherits LayoutComponentBase
@inject IAnalitica.Application.Reportes.INotificaciones Notificaciones

<header class="navbar navbar-expand bg-dark navbar-dark px-3">
    <a class="navbar-brand" href="/">IAnalitica</a>
    <AuthorizeView>
        <Authorized>
            <ul class="navbar-nav me-auto">
                <li class="nav-item"><a class="nav-link" href="/dashboards">Dashboards</a></li>
                <AuthorizeView Policy="reportes.exportar" Context="exportador">
                    <li class="nav-item"><a class="nav-link" href="/reportes">Mis reportes@(sinLeer > 0 ? " (" + sinLeer + ")" : "")</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="dash.auditor_config" Context="auditor">
                    <li class="nav-item"><a class="nav-link" href="/auditor">Salud de la configuración</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="dash.farmacia" Context="farmacia">
                    <li class="nav-item"><a class="nav-link" href="/precios">Cumplimiento de precios</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="admin.empresas" Context="superadmin">
                    <li class="nav-item"><a class="nav-link" href="/admin/empresas/nueva">Nueva empresa</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="admin.catalogos" Context="catalogos">
                    <li class="nav-item"><a class="nav-link" href="/admin/regulacion">Regulación</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="admin.usuarios" Context="costos">
                    <li class="nav-item"><a class="nav-link" href="/costos">Costos</a></li>
                </AuthorizeView>
                <AuthorizeView Policy="admin.usuarios" Context="admin">
                    <li class="nav-item"><a class="nav-link" href="/admin/usuarios">Usuarios</a></li>
                </AuthorizeView>
            </ul>
            <span class="navbar-text me-3">@context.User.Identity?.Name</span>
            <form method="post" action="/salir">
                <AntiforgeryToken />
                <button class="btn btn-outline-light btn-sm" type="submit">Salir</button>
            </form>
        </Authorized>
    </AuthorizeView>
</header>

<main class="container py-4">
    @Body
</main>

@code {
    private int sinLeer;

    protected override async Task OnInitializedAsync()
    {
        try { sinLeer = await Notificaciones.ContarNoLeidasAsync(default); }
        catch { sinLeer = 0; }   // el menú nunca debe tumbar la página (p. ej. la pantalla de ingreso, sin sesión)
    }
}
